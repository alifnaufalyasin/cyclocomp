# Copy to .env (which is not committed) and adjust if needed. Everything here is optional.

# Address and port the server listens on. 0.0.0.0 = reachable from the network (default).
# Use 127.0.0.1 to keep it local-only, e.g. when the tunnel runs on this same machine.
PB_BIND=0.0.0.0
PB_PORT=8090

# Only for the optional bundled Cloudflare Tunnel (docker compose --profile tunnel up -d).
TUNNEL_TOKEN=
